# Stage-1 QEMU image matches OP-TEE manifest 4.10.0 qemu_v8.xml and common.xml.
# Tags were checked with git ls-remote. prepare_sources.sh updates a tree only when its commit differs.
# This stage does not build mbedtls and leaves TF-A TRUSTED_BOARD_BOOT off. The boot public key is not checked in this image.

OPTEE_OS_URL=https://github.com/OP-TEE/optee_os.git
OPTEE_OS_TAG=4.10.0
OPTEE_CLIENT_URL=https://github.com/OP-TEE/optee_client.git
OPTEE_CLIENT_TAG=4.10.0
OPTEE_TEST_URL=https://github.com/OP-TEE/optee_test.git
OPTEE_TEST_TAG=4.10.0
OPTEE_EXAMPLES_URL=https://github.com/linaro-swg/optee_examples.git
OPTEE_EXAMPLES_TAG=4.10.0
OPTEE_BUILD_URL=https://github.com/OP-TEE/build.git
OPTEE_BUILD_TAG=4.10.0

TFA_URL=https://github.com/TrustedFirmware-A/trusted-firmware-a.git
TFA_TAG=v2.14.0
LINUX_URL=https://github.com/linaro-swg/linux.git
LINUX_TAG=optee-4.10.0
BUILDROOT_URL=https://github.com/buildroot/buildroot.git
BUILDROOT_TAG=2025.05
UBOOT_URL=https://github.com/u-boot/u-boot.git
UBOOT_TAG=v2025.07

# libuuid for libteeacl. build_libuuid.sh downloads this tarball into dep-src/.
LIBUUID_URL=https://mirrors.edge.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-2.41.3.tar.xz
LIBUUID_TAG=v2.41.3
